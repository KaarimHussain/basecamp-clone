# Local PostgreSQL (the postgresql-x64-18 Windows service). Create the DB first:
#   createdb -U postgres tfg_workspace
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tfg_workspace?schema=public"

# Generate with: npx auth secret
AUTH_SECRET=""
# Production only (behind nginx): AUTH_TRUST_HOST="true"

# Seeded owner account (prisma/seed.ts)
SEED_OWNER_EMAIL="owner@tfg.test"
SEED_OWNER_PASSWORD="change-me-123"

# File uploads are stored here (relative to the project root unless absolute).
UPLOAD_DIR="uploads"

# Email digest over SMTP. Without SMTP_URL the digest only logs to the console.
# e.g. smtps://user:pass@smtp.gmail.com:465  (URL-encode special characters in the password)
SMTP_URL=""
EMAIL_FROM="TFG Workspace <workspace@your-domain.com>"
APP_URL="http://localhost:3000"
# Generate with: npx auth secret
CRON_SECRET=""

# Realtime (Socket.io service, run with: npm run realtime)
REALTIME_SECRET=""
REALTIME_PORT="3001"
REALTIME_URL="http://localhost:3001"
NEXT_PUBLIC_REALTIME_URL="http://localhost:3001"
