generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  memberships   Member[]
  watching      CategoryWatcher[]
  tasksCreated  Task[]            @relation("TaskCreator")
  assignments   TaskAssignee[]
  subscriptions TaskSubscriber[]
  comments      Comment[]
  channels      ChannelMember[]
  messages      Message[]
  notifications Notification[]
  activity      Activity[]
  invitesSent   Invite[]
}

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  members    Member[]
  categories Category[]
  tags       Tag[]
  channels   Channel[]
  invites    Invite[]
}

enum Role {
  OWNER
  LEADERSHIP
  MEMBER
}

model Member {
  workspaceId String
  userId      String
  role        Role   @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([workspaceId, role])
}

model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id])

  @@index([workspaceId, email])
}

// ── Categories & tasks ────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String
  position    Int
  archivedAt  DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  watchers  CategoryWatcher[]
  tasks     Task[]
  channels  Channel[]

  @@index([workspaceId, position])
}

model CategoryWatcher {
  categoryId String
  userId     String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([categoryId, userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  categoryId  String
  title       String
  description Json?
  status      TaskStatus @default(TODO)
  priority    Int        @default(0)
  dueAt       DateTime?
  position    Float
  createdById String
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  archivedAt  DateTime?

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignees     TaskAssignee[]
  subscribers   TaskSubscriber[]
  tags          TaskTag[]
  comments      Comment[]
  attachments   Attachment[]
  activity      Activity[]
  notifications Notification[]

  @@index([categoryId, status, position])
  @@index([workspaceId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

enum SubReason {
  CREATOR
  ASSIGNEE
  MENTION
  LEADERSHIP
  MANUAL
}

model TaskSubscriber {
  taskId  String
  userId  String
  reason  SubReason
  mutedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, reason])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      Json
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([taskId, createdAt])
}

model Attachment {
  id        String  @id @default(cuid())
  taskId    String?
  commentId String?
  messageId String?
  key       String
  name      String
  mime      String
  size      Int

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// ── Chat ──────────────────────────────────────────────────

enum ChannelKind {
  PUBLIC
  PRIVATE
  DM
}

model Channel {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  kind        ChannelKind @default(PUBLIC)
  categoryId  String?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]

  @@index([workspaceId])
}

model ChannelMember {
  channelId  String
  userId     String
  lastReadAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  parentId  String?
  body      Json
  createdAt DateTime @default(now())

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  parent        Message?       @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Message[]      @relation("Thread")
  attachments   Attachment[]
  notifications Notification[]

  @@index([channelId, parentId, createdAt])
}

// ── Notifications & activity ──────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  taskId    String?
  messageId String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String
  meta      Json
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}
